{
  "name": "mylibrary-core",
  "version": "0.1.0",
  "description": "MyLibrary 共享数据层 — dsh 扩展版与 Flutter 跨平台版的唯一数据契约",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/types/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "mylibrary": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "node dist/cli.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^24.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoyang0618/bookstore-mylibrary.git"
  },
  "bugs": {
    "url": "https://github.com/zhaoyang0618/bookstore-mylibrary/issues"
  },
  "homepage": "https://github.com/zhaoyang0618/bookstore-mylibrary#readme",
  "optionalDependencies": {
    "pdf-lib": "^1.17.1"
  }
}
