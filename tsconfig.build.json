{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist/types",
    // dist/ 会提交进 git（供 dsh-extension 通过 git 依赖直接安装），
    // 因此关掉 sourcemap 与 declarationMap，避免产物臃肿、也避免调试信息入库。
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/__tests__/**/*"]
}
